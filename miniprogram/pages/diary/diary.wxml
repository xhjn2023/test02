<!-- pages/diary/diary.wxml -->
<view class="page-wrap">

  <view class="container">

    <!-- 顶部标题 -->
    <view class="page-header">
      <view class="row-between">
        <view>
          <view class="page-title">📖 日记</view>
          <view class="page-sub">记录生活 · 心情日记</view>
        </view>
        <view class="tag tag-primary">{{statTotal}} 篇</view>
      </view>
    </view>

    <!-- 日期选择区域 -->
    <view class="card">
      <view class="row-between">
        <view class="nav-btn" bindtap="onPrevDay">
          <text class="text-2xl text-gray-500">‹</text>
        </view>
        <view class="date-display" bindtap="onToggleCalendar">
          <view class="text-3xl font-bold text-gray-900">{{selectedDateLabel}}</view>
          <view class="text-xs text-muted mt-half">
            <text>📅 点击切换日期</text>
          </view>
        </view>
        <view class="nav-btn" bindtap="onNextDay">
          <text class="text-2xl text-gray-500">›</text>
        </view>
      </view>

      <!-- 日历展开 -->
      <view wx:if="{{showCalendar}}" class="calendar-wrap">
        <view class="divider"></view>
        <view class="calendar-head">
          <view class="calendar-nav-btn" bindtap="onPrevMonth">‹</view>
          <picker mode="date" fields="month" value="{{calendarPickerValue}}" bindchange="onPickerMonthChange">
            <view class="calendar-title">{{calendarTitle}}</view>
          </picker>
          <view class="calendar-nav-btn" bindtap="onNextMonth">›</view>
        </view>
        <view class="calendar-week">
          <view class="calendar-week-cell">日</view>
          <view class="calendar-week-cell">一</view>
          <view class="calendar-week-cell">二</view>
          <view class="calendar-week-cell">三</view>
          <view class="calendar-week-cell">四</view>
          <view class="calendar-week-cell">五</view>
          <view class="calendar-week-cell">六</view>
        </view>
        <view class="calendar-grid">
          <view wx:for="{{calendarCells}}" wx:key="key"
            class="calendar-cell {{item.classes}}"
            data-date="{{item.date}}"
            bindtap="onCalendarCellTap">
            <text>{{item.day}}</text>
          </view>
        </view>
        <view class="row gap-3 mt">
          <view class="btn-ghost flex-1" bindtap="onJumpToday">回到今日</view>
        </view>
      </view>
    </view>

    <!-- 日记内容编辑区 -->
    <view class="card">
      <view class="section-title">
        <text class="section-emoji">✏️</text>
        <text>今日心情</text>
      </view>
      <view class="mood-picker">
        <view wx:for="{{moods}}" wx:key="key"
          class="mood-option {{currentMood === item.key ? 'active' : ''}}"
          data-mood="{{item.key}}" bindtap="onMoodPick">
          <text class="mood-emoji">{{item.icon}}</text>
          <text class="mood-label">{{item.label}}</text>
        </view>
      </view>

      <view class="divider"></view>

      <view class="section-title">
        <text class="section-emoji">📝</text>
        <text>日记内容</text>
      </view>
      <textarea class="textarea-soft" value="{{diaryContent}}" placeholder="今天发生了什么？记录此刻的想法..."
        maxlength="-1" auto-height bindinput="onDiaryInput" />
      <view class="text-xs text-muted mt-half text-right">{{wcNum}} 字</view>

      <view class="divider"></view>

      <view class="section-title">
        <text class="section-emoji">🏷️</text>
        <text>标签</text>
      </view>
      <view class="row gap-2 flex-wrap">
        <view wx:for="{{presetTags}}" wx:key="*this"
          class="tag {{currentTags[item] ? 'tag-primary' : ''}}"
          data-tag="{{item}}" bindtap="onTagToggle">
          #{{item}}
        </view>
      </view>

      <view class="btn-primary mt" bindtap="onSaveDiary">
        <text>保存日记</text>
      </view>
    </view>

    <!-- 历史日记列表 -->
    <view class="card">
      <view class="section-title">
        <text class="section-emoji">📚</text>
        <text>历史日记</text>
      </view>
      <view wx:if="{{!diaryList.length}}" class="empty-state">
        <text class="empty-icon">📖</text>
        <text>暂无日记，开始记录今天吧</text>
      </view>
      <view wx:for="{{diaryList}}" wx:key="date" class="list-item"
        data-date="{{item.date}}" bindtap="onDiaryItemClick">
        <text class="text-2xl">{{item.moodIcon}}</text>
        <view class="flex-1">
          <view class="text-sm font-semibold text-gray-700">{{item.dateLabel}}</view>
          <view class="text-xs text-muted mt-half" style="line-height:1.4">{{item.preview}}</view>
        </view>
        <text class="text-muted">›</text>
      </view>
    </view>

  </view>

  <!-- 悬浮 + 按钮 -->
  <view class="fab" bindtap="onFabTap">
    <text>✓</text>
  </view>

</view>

<view wx:if="{{toastShow}}" class="toast"><text>{{toastMsg}}</text></view>
