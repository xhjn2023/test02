/* pages/diary/diary.wxss */
.grid-3 {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24rpx;
  margin-bottom: 24rpx;
}
.stat-box { text-align: center; padding: 28rpx 16rpx !important; }
.stat-num { font-size: 48rpx; font-weight: 700; }

/* 搜索 */
.search-row { position: relative; margin-bottom: 24rpx; }
.search-icon {
  position: absolute; left: 24rpx; top: 50%;
  transform: translateY(-50%); font-size: 24rpx; color: #cbd5e1;
}
.search-input {
  width: 100%; background: #f0fdf4; border-radius: 16rpx;
  padding: 16rpx 24rpx 16rpx 64rpx;
  font-size: 26rpx; color: #334155; box-sizing: border-box;
}

.diary-scroll { max-height: 720rpx; }
.diary-item {
  padding: 24rpx; border-radius: 16rpx;
  border: 2rpx solid transparent;
}
.diary-preview {
  color: #475569; line-height: 1.5;
  word-break: break-word;
}
