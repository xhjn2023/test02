/* pages/diary/diary.wxss */
.nav-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}
.nav-btn:active {
  background: #e5e7eb;
}
.date-display {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
}

/* 日历 */
.calendar-wrap {
  margin-top: 8rpx;
}
.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.calendar-nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #6b7280;
  border-radius: 16rpx;
}
.calendar-nav-btn:active {
  background: #f3f4f6;
}
.calendar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}
.calendar-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
}
.calendar-week-cell {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 12rpx 0;
}
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
}
.calendar-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #374151;
  border-radius: 16rpx;
  position: relative;
}
.calendar-cell.muted {
  color: #d1d5db;
}
.calendar-cell.today {
  color: #6366f1;
  font-weight: 600;
}
.calendar-cell.selected {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-weight: 600;
}
.calendar-cell.has-dot::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6366f1;
}
.calendar-cell.selected.has-dot::after {
  background: #ffffff;
}

.text-right {
  text-align: right;
}
