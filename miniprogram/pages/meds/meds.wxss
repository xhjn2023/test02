/* pages/meds/meds.wxss */
/* 环形进度 */
.ring-row { display: flex; align-items: center; gap: 40rpx; margin: 40rpx 0; }
.ring-wrap { position: relative; width: 224rpx; height: 224rpx; flex-shrink: 0; }
.ring-canvas { width: 224rpx; height: 224rpx; }
.ring-inner {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-pct { font-size: 44rpx; font-weight: 700; color: #1e293b; }
.ring-label { font-size: 20rpx; color: #94a3b8; margin-top: 4rpx; }
.ring-right { flex: 1; }
.big-num { display: flex; align-items: baseline; gap: 4rpx; margin-bottom: 8rpx; }

/* 低药量提醒 */
.alert-low {
  background: #fce7f3;
  border: 2rpx solid #fbcfe8;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 24rpx;
}
.alert-icon { font-size: 36rpx; }
.alert-title { color: #be185d; }
.alert-sub { color: #ec4899; }

/* 快捷操作 */
.grid-2 {
  display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx;
  margin-bottom: 24rpx;
}
.quick-btn {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  padding: 32rpx 24rpx !important;
}
.quick-icon {
  width: 88rpx; height: 88rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 700;
}
.quick-icon.mint { background: #f0fdf4; color: #22c55e; }
.quick-icon.amber { background: #fffbeb; color: #f59e0b; }

/* 历史 */
.history-scroll { max-height: 480rpx; }
.history-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx; border-radius: 12rpx;
}
.ci-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.ci-on { background: #dcfce7; color: #16a34a; }
.ci-off { background: #f1f5f9; color: #94a3b8; }
.bottle-item { padding: 16rpx; border-radius: 12rpx; }
.bar-track {
  width: 100%; height: 12rpx; background: #f1f5f9;
  border-radius: 100rpx; overflow: hidden;
}
.bar-fill {
  height: 100%; background: #4ade80; border-radius: 100rpx;
  transition: width 0.3s;
}
