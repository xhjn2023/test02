/* pages/index/index.wxss */
.page-wrap { min-height: 100vh; padding-bottom: 40rpx; }

/* === 顶部 === */
.header {
  position: sticky; top: 0; z-index: 30;
  background: rgba(253,252,249,0.92);
  backdrop-filter: blur(20rpx);
  border-bottom: 2rpx solid #dcfce7;
}
.header-inner {
  padding: 24rpx 32rpx 16rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.header-left { display: flex; align-items: center; gap: 20rpx; }
.logo {
  width: 80rpx; height: 80rpx; border-radius: 28rpx;
  background: linear-gradient(135deg, #86efac, #22c55e);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 30rpx -12rpx rgba(16,122,87,0.3);
}
.logo-icon { color: #fff; font-size: 36rpx; }
.title { font-size: 32rpx; font-weight: 600; color: #1e293b; line-height: 1.2; }
.sub { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }

.header-right { display: flex; align-items: center; gap: 12rpx; }
.icon-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 20rpx -8rpx rgba(0,0,0,0.08);
  display: flex; align-items: center; justify-content: center;
}
.sync-icon { font-size: 30rpx; color: #94a3b8; }
.sync-icon.spin { animation: spin 0.9s linear infinite; display: inline-block; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.sync-color-synced .sync-icon { color: #22c55e; }
.sync-color-syncing .sync-icon { color: #f59e0b; }
.sync-color-offline .sync-icon { color: #cbd5e1; }

/* === Tab === */
.tabs {
  padding: 0 32rpx;
  display: flex; gap: 48rpx;
  border-bottom: 0;
}
.tab {
  padding: 16rpx 0;
  font-size: 28rpx; color: #94a3b8;
  border-bottom: 4rpx solid transparent;
}
.tab-active {
  color: #15803d;
  border-bottom-color: #22c55e;
  font-weight: 600;
}

/* === 通用 === */
.mb { margin-bottom: 24rpx; }
.mb-half { margin-bottom: 12rpx; }
.mt { margin-top: 24rpx; }
.mt-half { margin-top: 12rpx; }
.text-base { font-size: 30rpx; }
.text-amber { color: #f59e0b; }
.text-purple { color: #a855f7; }
.text-mint { color: #15803d; }

/* === 环形进度 === */
.ring-row { display: flex; align-items: center; gap: 40rpx; margin: 40rpx 0; }
.ring-wrap { position: relative; width: 224rpx; height: 224rpx; flex-shrink: 0; }
.ring-canvas { width: 224rpx; height: 224rpx; }
.ring-inner {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-pct { font-size: 44rpx; font-weight: 700; color: #1e293b; }
.ring-label { font-size: 20rpx; color: #94a3b8; margin-top: 4rpx; }
.ring-right { flex: 1; }
.big-num { display: flex; align-items: baseline; gap: 4rpx; margin-bottom: 8rpx; }

/* === 低药量提醒 === */
.alert-low {
  background: #fce7f3;
  border: 2rpx solid #fbcfe8;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 24rpx;
}
.alert-icon { font-size: 36rpx; }
.alert-title { color: #be185d; }
.alert-sub { color: #ec4899; }

/* === 快捷操作 === */
.grid-2 {
  display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx;
  margin-bottom: 24rpx;
}
.quick-btn {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  padding: 32rpx 24rpx !important;
}
.quick-icon {
  width: 88rpx; height: 88rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 700;
}
.quick-icon.mint { background: #f0fdf4; color: #22c55e; }
.quick-icon.amber { background: #fffbeb; color: #f59e0b; }

/* === 设置 === */
.setting-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0fdf4;
}
.setting-row:last-child { border-bottom: 0; }
.num-input { width: 120rpx; text-align: center; }
.time-picker { min-width: 140rpx; text-align: center; }

/* Switch */
.switch {
  width: 96rpx; height: 56rpx; border-radius: 100rpx;
  background: #e2e8f0; position: relative;
  transition: background 0.2s;
}
.switch-on { background: #22c55e; }
.switch-dot {
  position: absolute; top: 6rpx; left: 6rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  transition: transform 0.2s;
}
.switch-on .switch-dot { transform: translateX(40rpx); }

/* === 历史 === */
.seg {
  display: flex; background: #f0fdf4; border-radius: 12rpx; padding: 4rpx;
}
.seg-btn {
  padding: 8rpx 24rpx; border-radius: 8rpx;
  font-size: 22rpx; color: #94a3b8;
}
.seg-active { background: #fff; color: #15803d; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.history-scroll { max-height: 480rpx; }
.empty { text-align: center; color: #94a3b8; font-size: 22rpx; padding: 48rpx 0; }

.history-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx; border-radius: 12rpx;
}
.ci-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.ci-on { background: #dcfce7; color: #16a34a; }
.ci-off { background: #f1f5f9; color: #94a3b8; }

.bottle-item { padding: 16rpx; border-radius: 12rpx; }
.bar-track {
  width: 100%; height: 12rpx; background: #f1f5f9;
  border-radius: 100rpx; overflow: hidden;
}
.bar-fill {
  height: 100%; background: #4ade80; border-radius: 100rpx;
  transition: width 0.3s;
}

/* === 日记 === */
.mood-row { display: flex; flex-wrap: wrap; gap: 10rpx; flex: 1; }
.mood-btn {
  padding: 8rpx 20rpx; border-radius: 100rpx;
  font-size: 22rpx; border: 2rpx solid;
  opacity: 0.55;
}
.mood-active { opacity: 1; box-shadow: 0 0 0 4rpx rgba(34,197,94,0.2); }
.mood-great { background: #fef9c3; color: #a16207; border-color: #fde047; }
.mood-good  { background: #dcfce7; color: #15803d; border-color: #86efac; }
.mood-ok    { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
.mood-bad   { background: #dbeafe; color: #1e40af; border-color: #93c5fd; }
.mood-sad   { background: #f3e8ff; color: #6b21a8; border-color: #d8b4fe; }

.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; flex: 1; }
.tag-btn {
  padding: 8rpx 20rpx; border-radius: 100rpx;
  font-size: 22rpx;
  background: #fff; color: #64748b; border: 2rpx solid #e2e8f0;
}
.tag-on { background: #22c55e; color: #fff; border-color: #22c55e; }

.diary-textarea {
  width: 100%; min-height: 240rpx;
  background: #f0fdf4; border-radius: 24rpx;
  padding: 24rpx; font-size: 26rpx; color: #334155;
  box-sizing: border-box; line-height: 1.6;
}
.btn-del {
  width: 96rpx; padding: 24rpx 0; border-radius: 24rpx;
  background: #fce7f3; color: #ec4899;
  text-align: center; font-size: 32rpx;
}

/* 统计 */
.grid-3 {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24rpx;
  margin-bottom: 24rpx;
}
.stat-box { text-align: center; padding: 28rpx 16rpx !important; }
.stat-num { font-size: 48rpx; font-weight: 700; }

/* 搜索 */
.search-row {
  position: relative; margin-bottom: 24rpx;
}
.search-icon {
  position: absolute; left: 24rpx; top: 50%;
  transform: translateY(-50%); font-size: 24rpx; color: #cbd5e1;
}
.search-input {
  width: 100%; background: #f0fdf4; border-radius: 16rpx;
  padding: 16rpx 24rpx 16rpx 64rpx;
  font-size: 26rpx; color: #334155; box-sizing: border-box;
}

.diary-scroll { max-height: 720rpx; }
.diary-item {
  padding: 24rpx; border-radius: 16rpx;
  border: 2rpx solid transparent;
}
.diary-preview {
  color: #475569; line-height: 1.5;
  word-break: break-word;
}
.tag-mini {
  font-size: 18rpx; padding: 4rpx 12rpx;
  border-radius: 8rpx; background: #f1f5f9; color: #64748b;
}

/* === 弹层 === */
.sheet-mask {
  position: fixed; inset: 0; z-index: 40;
  background: rgba(0,0,0,0.3);
  display: flex; align-items: flex-end; justify-content: center;
}
.sheet-box {
  width: 100%; max-width: 750rpx;
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slideUp 0.28s cubic-bezier(0.22,1,0.36,1);
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.sheet-handle {
  width: 80rpx; height: 8rpx; background: #e2e8f0;
  border-radius: 100rpx; margin: 0 auto 24rpx;
}
.sheet-field { margin-bottom: 24rpx; }
.err-text { color: #ef4444; margin-top: 8rpx; }

/* === Toast === */
.toast {
  position: fixed; top: 160rpx; left: 50%; transform: translateX(-50%);
  z-index: 50;
  background: #1e293b; color: #fff;
  font-size: 26rpx;
  padding: 18rpx 32rpx; border-radius: 100rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.2);
  animation: fadeIn 0.2s;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
