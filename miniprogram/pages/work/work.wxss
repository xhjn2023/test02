.page-header-inner {
  display: flex;
  align-items: flex-start;
}

.timeline-dot-done {
  background: rgba(16, 185, 129, 0.15) !important;
  color: #10b981;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  width: 100%;
  box-sizing: border-box;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  margin-bottom: 32rpx;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 32rpx;
}

.err-text {
  color: #ef4444;
}

.page-wrap {
  min-height: 100vh;
}

.list-item .checkbox {
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
}

.del-btn {
  color: #9ca3af;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.del-btn:active {
  color: #ef4444;
}
