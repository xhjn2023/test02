<view class="page-wrap">

  <view class="page-header">
    <view class="page-header-inner row-between">
      <view>
        <view class="page-title">💼 工作</view>
        <view class="page-sub">任务清单 · 优先级</view>
      </view>
      <view class="tag tag-primary">{{stat.pending}} / {{stat.total}}</view>
    </view>
  </view>

  <view class="container">
    <view class="card">
      <view class="row-between mb">
        <view class="text-base font-semibold text-gray-900">任务列表</view>
        <view class="seg">
          <view class="seg-btn {{filter === 'all' ? 'seg-active' : ''}}" data-f="all" bindtap="onFilter">全部</view>
          <view class="seg-btn {{filter === 'pending' ? 'seg-active' : ''}}" data-f="pending" bindtap="onFilter">待办</view>
          <view class="seg-btn {{filter === 'done' ? 'seg-active' : ''}}" data-f="done" bindtap="onFilter">已完成</view>
        </view>
      </view>
      <view wx:if="{{!list.length}}" class="empty-state">
        <text class="empty-icon">📝</text>
        <text>暂无任务，点击右下角 + 添加</text>
      </view>
      <view wx:for="{{list}}" wx:key="id" class="list-item">
        <view class="checkbox {{item.done ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="onToggle">
          <text wx:if="{{item.done}}" class="checkbox-icon">✓</text>
        </view>
        <view class="flex-1">
          <view class="row-between mb-half">
            <text class="text-sm {{item.done ? 'text-muted line-through' : 'font-medium text-gray-900'}}">{{item.title}}</text>
            <view class="tag {{item.priorityTagClass}}">{{item.priorityLabel}}</view>
          </view>
          <view class="text-xs text-muted row gap-2">
            <text wx:if="{{item.dueDate}}">📅 {{item.dueDate}}</text>
            <text>创建于 {{item.createdAtLabel}}</text>
          </view>
        </view>
        <view class="del-btn" data-id="{{item.id}}" bindtap="onDelete">删除</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">
        <text class="section-emoji">⏰</text>
        <text>今日时间轴</text>
      </view>
      <view wx:if="{{!timelineList.length}}" class="empty-state">
        <text class="empty-icon">☀️</text>
        <text>今日暂无任务</text>
      </view>
      <view wx:else class="timeline">
        <view wx:for="{{timelineList}}" wx:key="id" class="timeline-item">
          <view class="timeline-dot {{item.done ? 'timeline-dot-done' : ''}}">
            <text wx:if="{{item.done}}">✓</text>
            <text wx:else>📌</text>
          </view>
          <view class="timeline-time">{{item.timeLabel}}</view>
          <view class="timeline-title {{item.done ? 'text-muted line-through' : ''}}">{{item.title}}</view>
          <view class="timeline-desc">
            <text class="tag {{item.priorityTagClass}}">{{item.priorityLabel}}优先级</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onFabTap">+</view>
</view>

<view wx:if="{{showAddModal}}" class="modal-mask" bindtap="onCloseModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header row-between">
      <view class="text-lg font-semibold text-gray-900">新建任务</view>
      <view class="modal-close" bindtap="onCloseModal">✕</view>
    </view>
    <view class="sheet-field">
      <text class="text-xs text-muted">标题</text>
      <input class="input-soft" value="{{draft.title}}" placeholder="输入任务标题..."
        data-key="title" bindinput="onDraftInput" focus="{{showAddModal}}" />
    </view>
    <view class="row gap-3 mb">
      <view class="flex-1">
        <text class="text-xs text-muted">优先级</text>
        <view class="seg mt-half">
          <view class="seg-btn {{draft.priority === 1 ? 'seg-active' : ''}}" data-p="1" bindtap="onPriorityPick">高</view>
          <view class="seg-btn {{draft.priority === 2 ? 'seg-active' : ''}}" data-p="2" bindtap="onPriorityPick">中</view>
          <view class="seg-btn {{draft.priority === 3 ? 'seg-active' : ''}}" data-p="3" bindtap="onPriorityPick">低</view>
        </view>
      </view>
      <view class="flex-1">
        <text class="text-xs text-muted">截止日期</text>
        <picker mode="date" value="{{draft.dueDate}}" bindchange="onDueDateChange">
          <view class="input-soft mt-half time-picker">{{draft.dueDate || '选日期'}}</view>
        </picker>
      </view>
    </view>
    <view wx:if="{{draftErr}}" class="text-xs err-text mb">{{draftErr}}</view>
    <view class="btn-primary" bindtap="onAddTask"><text>添加任务</text></view>
  </view>
</view>

<view wx:if="{{toastShow}}" class="toast"><text>{{toastMsg}}</text></view>
