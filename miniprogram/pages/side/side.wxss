.page-wrap {
  min-height: 100vh;
}

.side-card {
  margin-bottom: 24rpx;
}

.side-progress-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.side-progress-wrap .progress-bar {
  flex: 1;
}

.side-progress-text {
  flex-shrink: 0;
  min-width: 60rpx;
  text-align: right;
  font-weight: 500;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  width: 100%;
  box-sizing: border-box;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  margin-bottom: 32rpx;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 32rpx;
}

.del-btn {
  color: #9ca3af;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.del-btn:active {
  color: #ef4444;
}
