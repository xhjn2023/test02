<!--pages/home/home.wxml-->
<view class="page-wrap">

  <!-- Hero 卡片 -->
  <view class="container">
    <view class="card-hero gradient-primary">
      <view class="hero-bg-deco">✨</view>
      <view class="text-sm text-white" style="opacity: 0.9;">{{greeting}}</view>
      <view class="text-2xl text-white mt-half">{{heroTitle}}</view>
      <view class="row gap-4 mt">
        <view class="flex-1">
          <view class="text-xl font-bold text-white">{{hero.tasksDone}}/{{hero.tasksTotal}}</view>
          <view class="text-xs text-white" style="opacity: 0.8;">今日任务</view>
        </view>
        <view class="flex-1">
          <view class="text-xl font-bold text-white">{{hero.studyHours}}h {{hero.studyMinutes}}m</view>
          <view class="text-xs text-white" style="opacity: 0.8;">学习时长</view>
        </view>
        <view class="flex-1">
          <view class="text-xl font-bold text-white">{{hero.streak}}天</view>
          <view class="text-xs text-white" style="opacity: 0.8;">连续打卡</view>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-entry">
      <view class="quick-item" bindtap="goWork">
        <view class="quick-icon gradient-blue">💼</view>
        <view class="quick-label">工作</view>
      </view>
      <view class="quick-item" bindtap="goStudy">
        <view class="quick-icon gradient-primary">📚</view>
        <view class="quick-label">学习</view>
      </view>
      <view class="quick-item" bindtap="goLife">
        <view class="quick-icon gradient-green">🌿</view>
        <view class="quick-label">生活</view>
      </view>
      <view class="quick-item" bindtap="goSide">
        <view class="quick-icon gradient-orange">🚀</view>
        <view class="quick-label">副业</view>
      </view>
      <view class="quick-item" bindtap="goReview">
        <view class="quick-icon gradient-rose">🔍</view>
        <view class="quick-label">复盘</view>
      </view>
    </view>

    <!-- 五大板块 -->
    <view class="section-title">
      <text class="section-emoji">📋</text>
      <text>功能板块</text>
    </view>

    <view class="section-item" bindtap="goMeds">
      <view class="sec-icon gradient-green">💊</view>
      <view class="sec-text">
        <view class="sec-title">吃药提醒</view>
        <view class="sec-desc">连续 {{overview.meds.streak}} 天 · 剩余 {{overview.meds.remain}} 粒</view>
      </view>
      <view class="sec-arrow">›</view>
    </view>

    <view class="section-item" bindtap="goWork">
      <view class="sec-icon gradient-blue">💼</view>
      <view class="sec-text">
        <view class="sec-title">工作</view>
        <view class="sec-desc">待办 {{overview.work.pending}} 项 · 共 {{overview.work.total}} 项</view>
      </view>
      <view class="sec-arrow">›</view>
    </view>

    <view class="section-item" bindtap="goStudy">
      <view class="sec-icon gradient-primary">📚</view>
      <view class="sec-text">
        <view class="sec-title">学习</view>
        <view class="sec-desc">已完成 {{overview.study.done}} · 共 {{overview.study.total}} 计划</view>
      </view>
      <view class="sec-arrow">›</view>
    </view>

    <view class="section-item" bindtap="goLife">
      <view class="sec-icon gradient-green">🌿</view>
      <view class="sec-text">
        <view class="sec-title">生活</view>
        <view class="sec-desc">{{overview.life.today ? '今日已记录' : '今日未记录'}} · 共 {{overview.life.total}} 条</view>
      </view>
      <view class="sec-arrow">›</view>
    </view>

    <view class="section-item" bindtap="goSide">
      <view class="sec-icon gradient-orange">🚀</view>
      <view class="sec-text">
        <view class="sec-title">副业</view>
        <view class="sec-desc">进行中 {{overview.side.inProgress}} · 共 {{overview.side.total}} 项目</view>
      </view>
      <view class="sec-arrow">›</view>
    </view>

    <view class="section-item" bindtap="goReview">
      <view class="sec-icon gradient-rose">🔍</view>
      <view class="sec-text">
        <view class="sec-title">复盘</view>
        <view class="sec-desc">共 {{overview.review.total}} 篇 · 均分 {{overview.review.avgRating || '—'}}</view>
      </view>
      <view class="sec-arrow">›</view>
    </view>

  </view>

  <!-- 悬浮 + 按钮 -->
  <view class="fab" bindtap="onFabTap">+</view>

</view>

<!-- Toast -->
<view wx:if="{{toastShow}}" class="toast">
  <text>{{toastMsg}}</text>
</view>
