.page-wrap {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.rec-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.rec-item:last-child {
  border-bottom: none;
}

.rec-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.rec-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 6rpx;
}
