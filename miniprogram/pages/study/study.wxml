<!--pages/study/study.wxml-->
<view class="page-wrap">

  <!-- 顶部渐变 Header -->
  <view class="card-hero gradient-primary">
    <view class="hero-bg-deco">📚</view>
    <view class="row-between">
      <view>
        <view class="text-2xl text-white font-bold mb-half">学习成长</view>
        <view class="text-sm text-white" style="opacity: 0.9;">本周学习 {{weeklyHours}}h · 连续 {{streakDays}} 天</view>
      </view>
      <view class="row gap-2">
        <view class="hero-icon">🔍</view>
        <view class="hero-icon">🔔</view>
      </view>
    </view>
  </view>

  <view class="container">

    <!-- 分类标签横滑 -->
    <scroll-view class="cat-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{categories}}" wx:key="id" 
            class="cat-tag {{activeCategory === item.id ? 'active' : ''}}"
            data-id="{{item.id}}" bindtap="onCategoryTap">
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 统计卡片 2 列网格 -->
    <view class="stat-grid-2">
      <view class="stat-card">
        <view class="stat-icon gradient-blue">⏱</view>
        <view class="stat-label">本周学习</view>
        <view class="stat-value">{{weeklyHours}}<text class="text-sm" style="font-weight: 400;"> h</text></view>
        <view class="stat-sub text-green">↑ 12% 较上周</view>
      </view>
      <view class="stat-card">
        <view class="stat-icon gradient-orange">🔥</view>
        <view class="stat-label">连续学习</view>
        <view class="stat-value">{{streakDays}}<text class="text-sm" style="font-weight: 400;"> 天</text></view>
        <view class="stat-sub text-muted">继续保持！</view>
      </view>
    </view>

    <!-- 在学课程区域 -->
    <view class="section-title">
      <text class="section-emoji">📖</text>
      <text>在学课程</text>
    </view>

    <view wx:if="{{!courseList.length}}" class="empty-state">
      <text class="empty-icon">📚</text>
      <text>暂无学习计划，点击右下角添加</text>
    </view>

    <view wx:for="{{courseList}}" wx:key="id" class="course-card" bindtap="onCourseTap" data-id="{{item.id}}">
      <view class="course-banner {{item.bannerClass}}">
        <text>{{item.icon}}</text>
      </view>
      <view class="course-body">
        <view class="course-title">{{item.subject}}</view>
        <view class="course-meta">{{item.teacher}} · {{item.durationMin}} 课时</view>
        <view class="course-progress">
          <view class="progress-bar">
            <view class="progress-fill {{item.progressClass}}" style="width: {{item.progress}}%;"></view>
          </view>
          <view class="progress-text">{{item.progress}}%</view>
        </view>
      </view>
    </view>

    <!-- 推荐阅读区域 -->
    <view class="section-title" style="margin-top: 16rpx;">
      <text class="section-emoji">📰</text>
      <text>推荐阅读</text>
    </view>

    <view class="card" style="padding: 0;">
      <view wx:for="{{recommendList}}" wx:key="id" class="rec-item">
        <view class="rec-icon {{item.iconBg}}">{{item.icon}}</view>
        <view class="flex-1">
          <view class="rec-title">{{item.title}}</view>
          <view class="text-xs text-muted">{{item.source}} · {{item.readTime}} 分钟阅读</view>
        </view>
        <view class="text-muted">›</view>
      </view>
    </view>

  </view>

  <!-- 悬浮 + 按钮 -->
  <view class="fab" bindtap="onFabTap">+</view>

</view>

<view wx:if="{{toastShow}}" class="toast"><text>{{toastMsg}}</text></view>
