<!-- pages/study/study.wxml -->
<view class="page-wrap">

  <view class="page-header">
    <view class="page-header-inner">
      <view>
        <view class="page-title">📚 学习</view>
        <view class="page-sub">学习计划 · 时长统计</view>
      </view>
      <view class="tag">{{stat.done}}/{{stat.total}} · {{stat.minutes}} 分钟</view>
    </view>
  </view>

  <view class="container">
    <!-- 新建 -->
    <view class="card">
      <view class="text-sm font-semibold mb row gap-2">
        <text class="text-purple">＋</text><text>新建学习计划</text>
      </view>
      <view class="sheet-field">
        <text class="text-xs text-muted">主题</text>
        <input class="input-soft" value="{{draft.subject}}" placeholder="如：阅读《xxx》/ 学习 React..."
          data-key="subject" bindinput="onDraftInput" />
      </view>
      <view class="sheet-field">
        <text class="text-xs text-muted">详细内容（选填）</text>
        <textarea class="textarea-soft" value="{{draft.content}}" placeholder="章节范围 / 具体内容..."
          data-key="content" bindinput="onDraftInput" />
      </view>
      <view class="row gap-3 mb">
        <view class="flex-1">
          <text class="text-xs text-muted">计划时长（分钟）</text>
          <input class="input-soft num-input mt-half" type="number" value="{{draft.durationMin}}"
            data-key="durationMin" bindinput="onDraftInput" />
        </view>
        <view class="flex-1">
          <text class="text-xs text-muted">计划日期</text>
          <picker mode="date" value="{{draft.date}}" bindchange="onDateChange">
            <view class="input-soft mt-half time-picker">{{draft.date}}</view>
          </picker>
        </view>
      </view>
      <view wx:if="{{draftErr}}" class="text-xs err-text mb">{{draftErr}}</view>
      <view class="btn-primary" bindtap="onAddPlan"><text>添加计划</text></view>
    </view>

    <!-- 列表 -->
    <view class="card">
      <view class="row-between mb">
        <view class="text-sm font-semibold row gap-2">
          <text class="text-purple">📋</text><text>计划列表</text>
        </view>
        <view class="seg">
          <view class="seg-btn {{filter === 'all' ? 'seg-active' : ''}}" data-f="all" bindtap="onFilter">全部</view>
          <view class="seg-btn {{filter === 'pending' ? 'seg-active' : ''}}" data-f="pending" bindtap="onFilter">未完成</view>
          <view class="seg-btn {{filter === 'done' ? 'seg-active' : ''}}" data-f="done" bindtap="onFilter">已完成</view>
        </view>
      </view>
      <view wx:if="{{!list.length}}" class="empty-state">
        <text class="empty-icon">📖</text>
        <text>暂无学习计划，开始规划吧</text>
      </view>
      <view wx:for="{{list}}" wx:key="id" class="list-item">
        <view class="checkbox {{item.completed ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="onToggle">
          <text wx:if="{{item.completed}}" class="checkbox-icon">✓</text>
        </view>
        <view class="flex-1">
          <view class="row-between mb-half">
            <text class="text-sm {{item.completed ? 'text-muted line-through' : 'font-semibold'}}">{{item.subject}}</text>
            <text wx:if="{{item.durationMin}}" class="tag">{{item.durationMin}} 分钟</text>
          </view>
          <view wx:if="{{item.content}}" class="text-xs text-muted mb-half">{{item.content}}</view>
          <view class="text-xs text-muted">日期 {{item.date}} · 创建 {{item.createdAtLabel}}</view>
        </view>
        <view class="del-btn" data-id="{{item.id}}" bindtap="onDelete">🗑</view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{toastShow}}" class="toast"><text>{{toastMsg}}</text></view>
