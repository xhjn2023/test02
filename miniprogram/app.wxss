page {
  background: #f3f4f6;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx 28rpx 180rpx;
}

/* ===== 渐变主题 ===== */
.gradient-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
}
.gradient-pink {
  background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
}
.gradient-blue {
  background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
}
.gradient-green {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
}
.gradient-orange {
  background: linear-gradient(135deg, #f97316 0%, #fbbf24 100%);
}
.gradient-rose {
  background: linear-gradient(135deg, #f43f5e 0%, #fb7185 100%);
}

/* ===== 卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx -4rpx rgba(0, 0, 0, 0.05);
}

.card-hero {
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  color: #ffffff;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.card-hero .hero-bg-deco {
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 260rpx;
  height: 260rpx;
  opacity: 0.15;
  font-size: 220rpx;
  line-height: 260rpx;
  text-align: center;
}

/* ===== 顶部 header ===== */
.page-header {
  padding: 0 28rpx;
  padding-top: 32rpx;
  padding-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.3;
}

.page-sub {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* ===== 行布局 ===== */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }
.gap-4 { gap: 32rpx; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

/* ===== 文字 ===== */
.text-white { color: #ffffff; }
.text-primary { color: #6366f1; }
.text-muted { color: #9ca3af; }
.text-gray-500 { color: #6b7280; }
.text-gray-700 { color: #374151; }
.text-gray-900 { color: #111827; }
.text-green { color: #10b981; }
.text-red { color: #ef4444; }
.text-orange { color: #f97316; }
.text-rose { color: #f43f5e; }
.text-blue { color: #3b82f6; }
.text-purple { color: #8b5cf6; }

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 26rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 44rpx; font-weight: 700; }
.text-3xl { font-size: 56rpx; font-weight: 700; }
.text-4xl { font-size: 72rpx; font-weight: 700; }

.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.line-through { text-decoration: line-through; }

/* ===== 间距 ===== */
.mb { margin-bottom: 24rpx; }
.mb-half { margin-bottom: 12rpx; }
.mt { margin-top: 24rpx; }
.mt-half { margin-top: 12rpx; }
.ml { margin-left: 16rpx; }
.mr { margin-right: 16rpx; }
.p-0 { padding: 0; }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-primary {
  background: rgba(99, 102, 241, 0.1);
  color: #6366f1;
}
.tag-green {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}
.tag-orange {
  background: rgba(249, 115, 22, 0.1);
  color: #f97316;
}
.tag-rose {
  background: rgba(244, 63, 94, 0.1);
  color: #f43f5e;
}
.tag-blue {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}
.tag-purple {
  background: rgba(139, 92, 246, 0.1);
  color: #8b5cf6;
}

.tag-mini {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: #f3f4f6;
  color: #9ca3af;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
}

/* ===== 按钮 ===== */
.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(99, 102, 241, 0.4);
}
.btn-primary.btn-done {
  background: linear-gradient(135deg, #d1d5db 0%, #9ca3af 100%);
  box-shadow: none;
}
.btn-ghost {
  background: #f3f4f6;
  color: #4b5563;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
}

/* ===== 输入 ===== */
.input-soft {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  width: 100%;
  box-sizing: border-box;
}
.textarea-soft {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}
.sheet-field {
  margin-bottom: 20rpx;
}
.sheet-field .text-xs {
  margin-bottom: 10rpx;
  display: block;
}
.time-picker {
  color: #6b7280;
}

/* ===== 分段选择 ===== */
.seg {
  display: flex;
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 6rpx;
}
.seg-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #6b7280;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.seg-btn.seg-active {
  background: #ffffff;
  color: #6366f1;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx -2rpx rgba(0, 0, 0, 0.08);
}

/* ===== 复选框 ===== */
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ffffff;
  transition: all 0.2s;
}
.checkbox.checked {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  border-color: transparent;
}
.checkbox-icon {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

/* ===== 列表项 ===== */
.list-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 20rpx;
}
.list-item:last-child {
  border-bottom: none;
}

.del-btn {
  color: #ef4444;
  font-size: 28rpx;
  padding: 8rpx;
  flex-shrink: 0;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 60rpx 0 40rpx;
  color: #9ca3af;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon {
  font-size: 80rpx;
  opacity: 0.6;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 16rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-bar .progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 100%);
  transition: width 0.3s;
}
.progress-fill.green {
  background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
}
.progress-fill.blue {
  background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 100%);
}
.progress-fill.orange {
  background: linear-gradient(90deg, #f97316 0%, #fbbf24 100%);
}
.progress-fill.rose {
  background: linear-gradient(90deg, #ec4899 0%, #f472b6 100%);
}

/* ===== 评分星 ===== */
.rating-row {
  display: flex;
  gap: 8rpx;
}
.star {
  font-size: 36rpx;
  color: #d1d5db;
}
.star.on {
  color: #fbbf24;
}

/* ===== Toast ===== */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  padding: 24rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  z-index: 9999;
  max-width: 80%;
  text-align: center;
}

/* ===== 悬浮 + 按钮 ===== */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: 140rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 12rpx 32rpx -8rpx rgba(99, 102, 241, 0.5);
  z-index: 100;
}

/* ===== 模块快捷入口（首页） ===== */
.quick-entry {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  padding: 28rpx 20rpx;
  background: #ffffff;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.quick-label {
  font-size: 24rpx;
  color: #374151;
}

/* ===== 板块列表项（首页） ===== */
.section-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  gap: 24rpx;
}
.section-item .sec-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}
.section-item .sec-text {
  flex: 1;
}
.section-item .sec-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}
.section-item .sec-desc {
  font-size: 24rpx;
  color: #9ca3af;
}
.section-item .sec-arrow {
  color: #d1d5db;
  font-size: 32rpx;
  flex-shrink: 0;
}

/* ===== 统计卡片网格（学习/工作等） ===== */
.stat-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  position: relative;
}
.stat-card .stat-icon {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.stat-card .stat-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}
.stat-card .stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}
.stat-card .stat-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
}

/* ===== 分类 tag 横滑 ===== */
.cat-scroll {
  white-space: nowrap;
  padding: 0 4rpx;
  margin-bottom: 24rpx;
}
.cat-tag {
  display: inline-block;
  padding: 14rpx 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6b7280;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
}
.cat-tag.active {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-weight: 500;
  border-color: transparent;
}

/* ===== 时间轴 ===== */
.timeline {
  position: relative;
  padding-left: 24rpx;
}
.timeline::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 4rpx;
  background: #e5e7eb;
  border-radius: 4rpx;
}
.timeline-item {
  position: relative;
  padding-left: 56rpx;
  padding-bottom: 32rpx;
}
.timeline-item:last-child {
  padding-bottom: 0;
}
.timeline-dot {
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eef2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 1;
}
.timeline-time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}
.timeline-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 4rpx;
}
.timeline-desc {
  font-size: 24rpx;
  color: #6b7280;
}

/* ===== 情绪选择 ===== */
.mood-picker {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}
.mood-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  transition: all 0.2s;
}
.mood-option.active {
  background: rgba(99, 102, 241, 0.1);
}
.mood-option .mood-emoji {
  font-size: 64rpx;
}
.mood-option .mood-label {
  font-size: 24rpx;
  color: #6b7280;
}
.mood-option.active .mood-label {
  color: #6366f1;
  font-weight: 600;
}

/* ===== 评分条 ===== */
.score-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 14rpx 0;
}
.score-row .score-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #4b5563;
  flex-shrink: 0;
}
.score-row .score-bar {
  flex: 1;
  height: 20rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  overflow: hidden;
}
.score-row .score-bar .score-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.2s;
}
.score-row .score-value {
  width: 80rpx;
  text-align: right;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  flex-shrink: 0;
}

/* ===== 课程卡片 ===== */
.course-card {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx -4rpx rgba(0, 0, 0, 0.05);
}
.course-banner {
  height: 160rpx;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  font-size: 72rpx;
}
.course-body {
  padding: 28rpx 32rpx;
}
.course-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 10rpx;
}
.course-meta {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}
.course-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.course-progress .progress-bar {
  flex: 1;
}
.course-progress .progress-text {
  font-size: 26rpx;
  color: #6b7280;
  flex-shrink: 0;
  font-weight: 500;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: #f3f4f6;
  margin: 20rpx 0;
}

/* ===== section 标题 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-title .section-emoji {
  font-size: 32rpx;
}
