.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 20rpx -4rpx rgba(0, 0, 0, 0.08);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
}

.tab-icon {
  font-size: 44rpx;
  line-height: 1;
  opacity: 0.5;
  transition: all 0.2s;
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: translateY(-2rpx);
}

.tab-text {
  font-size: 20rpx;
  color: #9ca3af;
  transition: all 0.2s;
}

.tab-item.active .tab-text {
  color: #6366f1;
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  top: 6rpx;
  right: 50%;
  margin-right: -44rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 999rpx;
  text-align: center;
  box-sizing: border-box;
}
